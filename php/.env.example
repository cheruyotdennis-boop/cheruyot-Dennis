# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quantiq_prime
DB_USER=quantiq_user
DB_PASS=YourSecureDatabasePasswordHere

# NOWPayments LIVE API Credentials (account.nowpayments.io)
# 1. API Key: Found under "Store Settings" -> "API Keys"
NOWPAYMENTS_API_KEY=your_live_nowpayments_api_key_here

# 2. IPN Secret: Generated under "Store Settings" -> "Instant Payment Notifications"
NOWPAYMENTS_IPN_SECRET=your_live_ipn_secret_key_here

# Application Base URL (Used for generating live IPN webhook callbacks)
APP_URL=http://quantiqprime.com
